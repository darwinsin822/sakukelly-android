    const-string v3, "(function() {\n    // Prevenir ventanas emergentes y popups\n    window.open = function() { return null; };\n    \n    function autoCleanAds() {\n        // Selectores comunes de cierre de anuncios\n        const closeButtons = [\n            \'button.close\', \'a.close\', \'.btn-close\', \'.modal-close\',\n            \'[aria-label=\"Close\"]\', \'[aria-label=\"close\"]\', \'.close-btn\',\n            \'.dismiss\', \'.ad-close\', \'.popup-close\', \'#close-button\',\n            \'.overlay-close\', \'.ui-dialog-titlebar-close\', \'.push-notification-close\'\n        ];\n        closeButtons.forEach(sel => {\n            document.querySelectorAll(sel).forEach(el => {\n                try { el.click(); } catch(e){}\n            });\n        });\n        \n        // Ocultar iframes y divs de publicidad\n        const adContainers = [\n            \'iframe[src*=\"ads\"]\', \'iframe[src*=\"doubleclick\"]\', \'iframe[src*=\"google\"]\',\n            \'iframe[src*=\"adservice\"]\', \'div[class*=\"ad-\"]\', \'div[id*=\"ad-\"]\',\n            \'div[class*=\"banner\"]\', \'div[id*=\"banner\"]\', \'.adsbygoogle\',\n            \'[class*=\"sponsored\"]\', \'[id*=\"sponsored\"]\', \'.ad-container\', \'#ad-container\',\n            \'div[class*=\"popup\"]\', \'div[id*=\"popup\"]\', \'.ad-banner\', \'#ad-banner\'\n        ];\n        adContainers.forEach(sel => {\n            document.querySelectorAll(sel).forEach(el => {\n                try { el.style.display = \'none\'; el.style.visibility = \'hidden\'; } catch(e){}\n            });\n        });\n    }\n    \n    setInterval(autoCleanAds, 800);\n    autoCleanAds();\n})();"

